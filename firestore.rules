rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ← Put here the e-mail(s) of the clinic user(s) created in Authentication.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['CAMBIAR@correo.com'];
    }
    function okDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function okTime(t) { return t is string && t.matches('^[0-9]{2}:[0-9]{2}$'); }

    // Public: which times are taken (no personal data here).
    match /slots/{id} {
      allow read: if true;
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['date', 'time', 'status'])
        && okDate(request.resource.data.date) && okTime(request.resource.data.time)
        && request.resource.data.status == 'requested'
        && id == request.resource.data.date + '_' + request.resource.data.time
      );
      allow update, delete: if isStaff();
    }

    // Private: patient details. The public can only create a request,
    // together with a free slot, and can never read anything back.
    match /appointments/{id} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff() || (
        request.resource.data.keys().hasOnly(['slotId', 'date', 'time', 'status', 'name', 'phone', 'service', 'first', 'note', 'lang', 'createdAt'])
        && request.resource.data.status == 'requested'
        && okDate(request.resource.data.date) && okTime(request.resource.data.time)
        && request.resource.data.slotId == request.resource.data.date + '_' + request.resource.data.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 25
        && request.resource.data.service is string && request.resource.data.service.size() <= 60
        && request.resource.data.first is string && request.resource.data.first.size() <= 3
        && request.resource.data.note is string && request.resource.data.note.size() <= 400
        && request.resource.data.lang in ['es', 'en']
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
      );
    }
  }
}
